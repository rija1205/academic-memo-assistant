# Application
APP_ENV=development
SECRET_KEY=replace-this-development-secret
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_NAME=ama_session
CSRF_COOKIE_NAME=ama_csrf
SESSION_TTL_DAYS=30
SECURE_COOKIES=false
AUTH_EXPOSE_RESET_TOKEN=false
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Google OAuth (connexion uniquement; aucun scope Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/backend/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile

# PostgreSQL / pgvector
POSTGRES_DB=academic_memo
POSTGRES_USER=academic_memo
POSTGRES_PASSWORD=academic_memo_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Used by the API when it runs outside Docker; Compose derives its URL from the POSTGRES_* values.
DATABASE_URL=postgresql+asyncpg://academic_memo:academic_memo_dev@localhost:5432/academic_memo

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Frontend
BACKEND_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Academic Memo Assistant
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_API_URL=/api/backend

# Optional dedicated database for integration tests
# TEST_DATABASE_URL=postgresql+asyncpg://academic_memo:academic_memo_dev@localhost:5432/academic_memo_test

# Sources / import pipeline
SOURCE_PROCESSING_MODE=async
SOURCE_STORAGE_PROVIDER=local
SOURCE_LOCAL_STORAGE_PATH=./var/source-storage
SOURCE_MAX_UPLOAD_BYTES=52428800
SOURCE_WORKER_URL=http://localhost:8000
SOURCE_WORKER_TOKEN=local-worker-token
SOURCE_OCR_PROVIDER=none
# S3-compatible storage (AWS S3, MinIO, or another provider)
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=academic-memo
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Stage 6 - academic RAG (retrieval only, no language model)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-hash-1536
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_VERSION=v1
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2
EMBEDDING_PRICE_PER_MILLION_TOKENS_USD=0.0

CHUNKING_VERSION=v1
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP_TOKENS=120
CHUNK_MIN_TOKENS=40

RAG_SEARCH_STRATEGY=hybrid
RAG_FUSION_METHOD=rrf
RAG_RRF_K=60
RAG_RRF_WEIGHT_VECTOR=1.0
RAG_RRF_WEIGHT_LEXICAL=1.0
RAG_DEFAULT_TOP_K=10
RAG_MAX_TOP_K=50
RAG_CANDIDATE_MULTIPLIER=4
RAG_TEXT_SEARCH_CONFIG=simple

RERANKER_PROVIDER=none
RERANKER_MODEL=
RERANKER_API_KEY=

# Stage 7 - academic assistant (OpenAI). The API key stays server-side only.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=900
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_PRICE_INPUT_PER_MILLION_TOKENS_USD=0.0
LLM_PRICE_OUTPUT_PER_MILLION_TOKENS_USD=0.0

ASSISTANT_MAX_INPUT_TOKENS=12000
ASSISTANT_MAX_HISTORY_MESSAGES=10
ASSISTANT_TOP_K=8
ASSISTANT_MIN_CONTEXT_SCORE=0.0
ASSISTANT_MAX_QUESTIONS_PER_MINUTE=10
ASSISTANT_MAX_DAILY_TOKENS=200000
ASSISTANT_MAX_QUESTION_LENGTH=4000
ASSISTANT_RATE_LIMIT_ENABLED=true

# Stage 8 - assisted writing. The model proposes; the author applies.
WRITING_TOP_K=8
WRITING_MAX_SELECTION_CHARS=20000
WRITING_MAX_SECTION_CHARS=60000
WRITING_MAX_INSTRUCTION_CHARS=1000

# Future integrations (not enabled yet)
# OPENAI_API_KEY=
# GEMINI_NOTEBOOK_PROJECT_ID=
# GEMINI_NOTEBOOK_LOCATION=global

# ---------------------------------------------------------------------------
# Etape 9 - bibliographie
# ---------------------------------------------------------------------------
# Un fichier BibTeX / RIS est une entree non fiable : sa taille et son nombre
# d'entrees sont bornes avant tout traitement. Un import trop volumineux
# renvoie 413, et un champ trop long est refuse par le schema.
BIBLIOGRAPHY_MAX_IMPORT_BYTES=2097152
BIBLIOGRAPHY_MAX_IMPORT_ENTRIES=2000
BIBLIOGRAPHY_MAX_EXPORT_REFERENCES=1000

# ---------------------------------------------------------------------------
# Etape 10 - citations academiques
# ---------------------------------------------------------------------------
# Aucune variable n'est introduite ici : le style vient de
# projects.bibliography_style (deja present depuis la migration 0003) et les
# limites d'import/saisie sont des constantes du code, pas de la configuration.
# Ces deux valeurs ne sont documentees que parce qu'elles sont reellement
# necessaires a l'exploitation.
#
# Style applique quand projects.bibliography_style est vide ou inconnu.
# CITATION_DEFAULT_STYLE=apa7
#
# Nombre maximal de references dans une seule citation (schemas.py).
# CITATION_MAX_REFERENCES_PER_CITATION=20

# ---------------------------------------------------------------------------
# Etape 11 - exports PDF / DOCX
# ---------------------------------------------------------------------------
# Taille maximale d'un fichier genere. Au-dela, l'export est refuse avant
# d' streamed la reponse plutot que de saturer la memoire du serveur.
EXPORT_MAX_OUTPUT_BYTES=209715200

# Duree maximale d'une generation d'export.
EXPORT_TIMEOUT_SECONDS=300

# Integrer les images distantes (HTTP) dans un export. Desactive par defaut :
# aller chercher une URL fournie par un auteur est un vecteur d'SSRF. L'activation
# seule ne suffit pas, les adresses privees restent refusees cote serveur.
EXPORT_ALLOW_REMOTE_IMAGES=false

# ---------------------------------------------------------------------------
# Etape 13 - securite et administration
# ---------------------------------------------------------------------------
# Budget de requetes, distinct du limiteur de connexion. Une categorie protege
# chaque operation couteuse afin qu'une boucle ne transforme pas un export ou une
# requete RAG en deni de service. Fenetre commune : RATE_LIMIT_WINDOW_SECONDS.
RATE_LIMIT_ENABLED=true
# Un Redis injoignable fait repondre 503 plutot que de servir la route sans
# protection. A laisser actif hors developpement : un limiteur qui echoue en
# silence n'est pas un limiteur.
RATE_LIMIT_FAIL_CLOSED=true
RATE_LIMIT_WINDOW_SECONDS=60
EXPORT_RATE_LIMIT_MAX_CALLS=20
RAG_RATE_LIMIT_MAX_CALLS=60
ASSISTANT_RATE_LIMIT_MAX_CALLS=30
WRITING_RATE_LIMIT_MAX_CALLS=30
AUDIT_RATE_LIMIT_MAX_CALLS=30
IMPORT_RATE_LIMIT_MAX_CALLS=20
WRITE_RATE_LIMIT_MAX_CALLS=180
# Derriere un proxy qui termine TLS, activer pour envoyer Strict-Transport-Security.
FORCE_HTTPS=false
HSTS_MAX_AGE=31536000

# ---------------------------------------------------------------------------
# Etape 14 - exploitation, sauvegarde et deploiement
# ---------------------------------------------------------------------------
# Repertoire ou scripts/backup.py ecrit les sauvegardes. Hors du depot : un
# dossier de sauvegarde versionne devient un depot lourd, et un secret dans un
# depot git est un secret compromis.
BACKUP_ROOT=backups

# Nombre de sauvegardes conservees par « backup.py prune ». Seules les
# sauvegardes verifiees sont supprimees : une sauvegarde d'integrite inconnue
# est peut-etre la seule copie de quelque chose.
BACKUP_KEEP=14

# Repertoire de stockage local des sources, inclus dans la sauvegarde. L'outil
# lit SOURCE_LOCAL_STORAGE_PATH (defini plus haut) : ne pas dupliquer ce chemin
# sous un autre nom, la sauvegarde doit suivre la configuration de l'application.

# Port publie par le frontend. Seul service expose en production : l'overlay
# ferme les ports du backend, de PostgreSQL et de Redis.
FRONTEND_PORT=3000

# Jeton partage entre l'API et le worker pour les appels internes. A remplacer
# en production : une valeur de developpement est une credential, pas une
# commodite.
SOURCE_WORKER_TOKEN=local-worker-token
